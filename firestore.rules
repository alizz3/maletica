rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada persona solo puede leer y escribir SU documento.
    match /usuarios/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      // Validación del lado del servidor de lo que se guarda
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['estado', 'actualizado'])
        && request.resource.data.estado is string
        && request.resource.data.estado.size() < 200000
        && request.resource.data.actualizado == request.time;
    }

    // Todo lo demás está cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
