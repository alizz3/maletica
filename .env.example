# Copia este archivo como .env.local para probar en tu computador.
# En Vercel se ponen en Settings → Environment Variables (nunca en el repo).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Opcional: App Check (reCAPTCHA v3) contra bots
VITE_RECAPTCHA_SITE_KEY=

# Opcional: Google Analytics 4 (solo carga si la persona acepta cookies)
VITE_GA_ID=
